{
  "name": "opentoon",
  "version": "1.1.0-beta.1",
  "description": "Finca Animate: an open-source 2D animation studio for Linux and Windows, inspired by Toon Boom Harmony. Based on OpenToon Studio.",
  "main": "electron/main.js",
  "desktopName": "opentoon-studio.desktop",
  "scripts": {
    "dev": "electron . --dev",
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "publish": "electron-builder --win --publish always",
    "check-update": "node tools/check-update.cjs",
    "test:electron": "node tests/electron-smoke.cjs",
    "test:render": "node tests/render-cli.cjs",
    "test:files": "node tests/phase0.cjs",
    "test": "node tests/update-check.cjs && node tests/browsertest.cjs && node tests/vector.cjs && node tests/visual.cjs && node tests/pen.cjs && node tests/features2.cjs && node tests/easing.cjs && node tests/lighttable.cjs && node tests/transform.cjs && node tests/pegs.cjs && node tests/combined.cjs && node tests/quickwins.cjs && node tests/palettes.cjs && node tests/curves.cjs",
    "publish:linux": "electron-builder --linux --publish always"
  },
  "keywords": [
    "animation",
    "2d",
    "toonboom",
    "opentoon"
  ],
  "author": "Finca Zero Studio",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.60.0"
  },
  "build": {
    "appId": "com.fincazero.animate",
    "productName": "Finca Animate",
    "files": [
      "index.html",
      "src/**/*",
      "styles/**/*",
      "electron/**/*",
      "assets/**/*",
      "splash/**/*",
      "pen/**/*",
      "fonts/**/*"
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.opentoon.txt"
      },
      {
        "from": "fonts",
        "to": "licenses/fonts",
        "filter": [
          "OFL-*.txt"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Finca-Animate-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "assets/icons",
      "executableName": "opentoon-studio",
      "category": "Graphics",
      "synopsis": "2D animation studio inspired by Toon Boom Harmony (based on OpenToon)",
      "artifactName": "Finca-Animate-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "desktop": {
        "StartupWMClass": "opentoon-studio",
        "Keywords": "animation;2d;cartoon;drawing;timeline;"
      }
    },
    "fileAssociations": [
      {
        "ext": "otoon",
        "name": "Animation Project (.otoon)",
        "description": "Finca Animate / OpenToon animation project",
        "icon": "assets/otoon-file.ico",
        "mimeType": "application/x-opentoon"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fincazerostudio",
        "repo": "finca-animate",
        "releaseType": "release"
      }
    ]
  }
}
